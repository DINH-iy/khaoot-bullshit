generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum SessionMode {
  LIVE
  REHEARSAL
}

enum SessionStatus {
  LOBBY
  RUNNING
  PAUSED
  RECOVERING
  FINISHED
}

enum StageStatus {
  ACTIVE
  CLOSED
  VOID
}

enum AssetKind {
  IMAGE
  GIF
  VIDEO
  // Strokes as validated JSON (see the drawing contract), never an image.
  DRAWING
}

// What a stored file is for: an answer in a round (or a part of a relay drawing), or a player's picture.
enum AssetPurpose {
  ANSWER
  AVATAR
}

enum ScoreKind {
  AWARD
  ADJUSTMENT
  REVERSAL
  TRANSFER
}

enum DecisionReason {
  VOTE
  HOST
  TIE_BREAK
  FALLBACK
  DRAW
}

enum EventAudience {
  HOST
  DISPLAY
  PLAYER
}

enum RoomRole {
  HOST
  DISPLAY
}

enum CredentialSource {
  OIDC
  LOCAL_REHEARSAL
}

// Authoring: mutable drafts and immutable published versions share one database.
model Creator {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  issuer    String   @db.VarChar(512)
  subject   String   @db.VarChar(255)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  games    Game[]
  versions GameVersion[]
  sessions GameSession[]
  prefabs  ScenePrefab[]
  styles   ThemeStyle[]

  @@unique([issuer, subject])
  @@map("creators")
}

model Game {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  creatorId  String    @db.Uuid
  title      String    @db.VarChar(160)
  // The owner's own version of a built-in game (its key in game/templates.ts): edited and published like any
  // game, and used instead of the built-in once published. Restoring the original archives it and clears this.
  builtInKey String?   @db.VarChar(64)
  archivedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @default(now()) @updatedAt @db.Timestamptz(3)

  creator    Creator         @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  draft      GameDraft?
  versions   GameVersion[]
  savePoints GameSavePoint[]

  @@unique([creatorId, builtInKey])
  @@index([creatorId, archivedAt])
  @@map("games")
}

model GameDraft {
  gameId           String   @id @db.Uuid
  revision         Int      @default(0)
  definitionFormat Int      @default(1)
  definition       Json     @db.JsonB
  updatedAt        DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  game Game @relation(fields: [gameId], references: [id], onDelete: Restrict)

  @@map("game_drafts")
}

model GameVersion {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  gameId           String   @db.Uuid
  number           Int
  definitionFormat Int      @default(1)
  definition       Json     @db.JsonB
  contentHash      String   @db.Char(64)
  createdById      String   @db.Uuid
  createdAt        DateTime @default(now()) @db.Timestamptz(3)

  game      Game          @relation(fields: [gameId], references: [id], onDelete: Restrict)
  createdBy Creator       @relation(fields: [createdById], references: [id], onDelete: Restrict)
  sessions  GameSession[]

  @@unique([gameId, number])
  @@map("game_versions")
}

// Save points: copies of a game's whole draft (card positions included) made on purpose in the editor, to go
// back to later. Going back puts the copy into the draft as an ordinary, validated save.
model GameSavePoint {
  id         String   @id @db.Uuid
  gameId     String   @db.Uuid
  name       String   @db.VarChar(80)
  // Made by the editor just before going back to another save point.
  automatic  Boolean  @default(false)
  // The person's name when it was made; null for the owner.
  savedBy    String?  @db.VarChar(80)
  sceneCount Int
  definition Json     @db.JsonB
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId, createdAt])
  @@map("game_save_points")
}

// Runtime: each session uses one immutable version, never the current draft.
model GameSession {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  gameVersionId  String        @db.Uuid
  hostId         String        @db.Uuid
  mode           SessionMode   @default(LIVE)
  status         SessionStatus @default(LOBBY)
  roomCode       String?       @unique @db.VarChar(12)
  revision       Int           @default(0)
  currentNodeKey String?       @db.VarChar(128)
  state          Json          @default("{}") @db.JsonB
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @default(now()) @updatedAt @db.Timestamptz(3)
  endedAt        DateTime?     @db.Timestamptz(3)
  idleCloseAt    DateTime?     @db.Timestamptz(3)

  gameVersion GameVersion     @relation(fields: [gameVersionId], references: [id], onDelete: Restrict)
  host        Creator         @relation(fields: [hostId], references: [id], onDelete: Restrict)
  players     SessionPlayer[]
  teams       SessionTeam[]
  lineups     TeamLineup[]
  stages      StageRun[]
  commands    GameCommand[]
  auditEvents AuditEvent[]
  outbox      OutboxEvent[]
  roomCredentials RoomCredential[]
  arcadeRound     ArcadeRound?

  @@index([hostId, status])
  @@index([idleCloseAt])
  @@index([gameVersionId])
  @@map("game_sessions")
}

model SessionPlayer {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId   String    @db.Uuid
  displayName String    @db.VarChar(40)
  joinedAt    DateTime  @default(now()) @db.Timestamptz(3)
  leftAt      DateTime? @db.Timestamptz(3)
  joinKeyHash String?   @unique @db.Char(64)
  // The person (account the owner made) this seat belongs to; null for guests.
  personId    String?   @db.Uuid
  // The player's own look: built-in character parts, validated by PlayerLookSchema. Null means the default made from the ID.
  look        Json?     @db.JsonB

  session     GameSession        @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  credentials PlayerCredential[]
  memberships TeamMember[]
  submissions Submission[]
  scores      ScoreEntry[]
  judgments   StageJudgment[]
  assets      Asset[]
  person      Person?            @relation(fields: [personId], references: [id], onDelete: Restrict)
  chips       ChipEntry[]
  sideRounds  SideRound[]
  items       CollectedItem[]
  challengesMade     SideChallenge[] @relation("ChallengeChallenger")
  challengesReceived SideChallenge[] @relation("ChallengeOpponent")
  arcadeSeat         ArcadeSeat?

  @@unique([sessionId, id])
  // A person has at most one seat per room: joining again continues it.
  @@unique([sessionId, personId])
  @@map("session_players")
}

model RoomCredential {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId String @db.Uuid
  role      RoomRole
  source    CredentialSource @default(OIDC)
  tokenHash String @unique @db.Char(64)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)

  session GameSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@index([sessionId, role])
  @@map("room_credentials")
}

model PlayerCredential {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId String    @db.Uuid
  playerId  String    @db.Uuid
  tokenHash String    @unique @db.Char(64)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt DateTime  @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)

  player SessionPlayer @relation(fields: [sessionId, playerId], references: [sessionId, id], onDelete: Restrict)

  @@index([sessionId, playerId])
  @@map("player_credentials")
}

model SessionTeam {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId String   @db.Uuid
  name      String   @db.VarChar(60)
  // The team's colour (#rrggbb), picked while teams were made; null: from its name.
  color     String?  @db.VarChar(7)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  session     GameSession  @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  memberships TeamMember[]
  submissions Submission[]
  scores      ScoreEntry[]

  @@unique([sessionId, id])
  @@unique([sessionId, name])
  @@map("session_teams")
}

model TeamLineup {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId String   @db.Uuid
  number    Int
  carryover Json     @default("{}") @db.JsonB
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  session GameSession  @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  members TeamMember[]
  stages  StageRun[]
  scores  ScoreEntry[]

  @@unique([sessionId, id])
  @@unique([sessionId, number])
  @@map("team_lineups")
}

model TeamMember {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId String  @db.Uuid
  lineupId  String  @db.Uuid
  teamId    String  @db.Uuid
  playerId  String  @db.Uuid
  isCaptain Boolean @default(false)

  lineup TeamLineup    @relation(fields: [sessionId, lineupId], references: [sessionId, id], onDelete: Restrict)
  team   SessionTeam   @relation(fields: [sessionId, teamId], references: [sessionId, id], onDelete: Restrict)
  player SessionPlayer @relation(fields: [sessionId, playerId], references: [sessionId, id], onDelete: Restrict)

  @@unique([lineupId, playerId])
  @@index([sessionId, teamId])
  @@map("team_members")
}

model StageRun {
  id                String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId         String      @db.Uuid
  number            Int
  nodeKey           String      @db.VarChar(128)
  stageKey          String      @db.VarChar(128)
  status            StageStatus @default(ACTIVE)
  lineupId          String?     @db.Uuid
  eligibility       Json        @default("{}") @db.JsonB
  presentation      Json        @default("{}") @db.JsonB
  openedAt          DateTime    @default(now()) @db.Timestamptz(3)
  deadlineAt        DateTime?   @db.Timestamptz(3)
  pausedRemainingMs Int?
  closedAt          DateTime?   @db.Timestamptz(3)
  // Results (answer, awards, scores) of a closed stage become public only once revealed.
  revealedAt        DateTime?   @db.Timestamptz(3)

  session     GameSession     @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  lineup      TeamLineup?     @relation(fields: [sessionId, lineupId], references: [sessionId, id], onDelete: Restrict)
  submissions Submission[]
  decision    RouteDecision?
  scores      ScoreEntry[]
  judgments   StageJudgment[]
  assets      Asset[]

  @@unique([sessionId, id])
  @@unique([sessionId, number])
  @@map("stage_runs")
}

model Submission {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId  String   @db.Uuid
  stageRunId String   @db.Uuid
  actorKey   String   @db.VarChar(160)
  slotKey    String   @default("answer") @db.VarChar(128)
  playerId   String?  @db.Uuid
  teamId     String?  @db.Uuid
  revision   Int      @default(0)
  value      Json     @db.JsonB
  receivedAt DateTime @default(now()) @db.Timestamptz(3)

  stage  StageRun       @relation(fields: [sessionId, stageRunId], references: [sessionId, id], onDelete: Restrict)
  player SessionPlayer? @relation(fields: [sessionId, playerId], references: [sessionId, id], onDelete: Restrict)
  team   SessionTeam?   @relation(fields: [sessionId, teamId], references: [sessionId, id], onDelete: Restrict)
  asset  Asset?

  @@unique([stageRunId, actorKey, slotKey])
  @@index([sessionId, stageRunId])
  @@map("submissions")
}

// An uploaded picture, GIF or video. The bytes live on disk under the media
// directory; this row is the authority on who uploaded it, for which stage,
// what it was verified to be, and which saved answer uses it.
model Asset {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId    String    @db.Uuid
  // Null for a player's picture, which belongs to no round.
  stageRunId   String?   @db.Uuid
  playerId     String    @db.Uuid
  kind         AssetKind
  purpose      AssetPurpose @default(ANSWER)
  contentType  String    @db.VarChar(64)
  byteSize     Int
  sha256       String    @db.Char(64)
  submissionId String?   @unique @db.Uuid
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  // Set when the file was deleted by the clean-up; the row stays for history and audit.
  removedAt    DateTime? @db.Timestamptz(3)

  stage      StageRun?     @relation(fields: [sessionId, stageRunId], references: [sessionId, id], onDelete: Restrict)
  player     SessionPlayer @relation(fields: [sessionId, playerId], references: [sessionId, id], onDelete: Restrict)
  submission Submission?   @relation(fields: [submissionId], references: [id], onDelete: Restrict)

  @@unique([sessionId, id])
  @@index([stageRunId, playerId])
  @@index([sessionId, removedAt])
  @@map("assets")
}

model RouteDecision {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId          String         @db.Uuid
  stageRunId         String         @unique @db.Uuid
  commandId          String         @db.Uuid
  selectedEdgeKey    String         @db.VarChar(128)
  destinationNodeKey String         @db.VarChar(128)
  reason             DecisionReason
  voteSnapshot       Json           @db.JsonB
  createdAt          DateTime       @default(now()) @db.Timestamptz(3)

  stage   StageRun    @relation(fields: [sessionId, stageRunId], references: [sessionId, id], onDelete: Restrict)
  command GameCommand @relation(fields: [sessionId, commandId], references: [sessionId, id], onDelete: Restrict)

  @@unique([sessionId, stageRunId])
  @@map("route_decisions")
}

// A row represents a committed outcome, written with its related state/audit/outbox.
model GameCommand {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId   String   @db.Uuid
  commandKey  String   @db.Uuid
  actorKey    String   @db.VarChar(160)
  type        String   @db.VarChar(80)
  requestHash String   @db.Char(64)
  result      Json     @db.JsonB
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  session   GameSession     @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  scores    ScoreEntry[]
  decisions RouteDecision[]
  audit     AuditEvent[]
  judgments StageJudgment[]

  @@unique([sessionId, id])
  @@unique([sessionId, actorKey, commandKey])
  @@map("game_commands")
}

// A zero-point decision is still a durable judgment. Corrections are a later
// append-only operation, not an update of this historical decision.
model StageJudgment {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId   String   @db.Uuid
  stageRunId  String   @db.Uuid
  playerId    String   @db.Uuid
  commandId   String   @db.Uuid
  amountMilli BigInt
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  stage   StageRun      @relation(fields: [sessionId, stageRunId], references: [sessionId, id], onDelete: Restrict)
  player  SessionPlayer @relation(fields: [sessionId, playerId], references: [sessionId, id], onDelete: Restrict)
  command GameCommand   @relation(fields: [sessionId, commandId], references: [sessionId, id], onDelete: Restrict)

  @@unique([stageRunId, playerId])
  @@index([sessionId, commandId])
  @@map("stage_judgments")
}

// Signed fixed-point integers: 1,000 milli-points = 1 point. Never JS floats.
model ScoreEntry {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId         String    @db.Uuid
  commandId         String    @db.Uuid
  awardKey          String    @db.VarChar(200)
  stageRunId        String?   @db.Uuid
  lineupId          String?   @db.Uuid
  recipientPlayerId String?   @db.Uuid
  recipientTeamId   String?   @db.Uuid
  amountMilli       BigInt
  kind              ScoreKind
  reason            String    @db.VarChar(240)
  reversesEntryId   String?   @db.Uuid
  transferGroupId   String?   @db.Uuid
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)

  command     GameCommand    @relation(fields: [sessionId, commandId], references: [sessionId, id], onDelete: Restrict)
  stage       StageRun?      @relation(fields: [sessionId, stageRunId], references: [sessionId, id], onDelete: Restrict)
  lineup      TeamLineup?    @relation(fields: [sessionId, lineupId], references: [sessionId, id], onDelete: Restrict)
  player      SessionPlayer? @relation(fields: [sessionId, recipientPlayerId], references: [sessionId, id], onDelete: Restrict)
  team        SessionTeam?   @relation(fields: [sessionId, recipientTeamId], references: [sessionId, id], onDelete: Restrict)
  reverses    ScoreEntry?    @relation("ScoreCorrection", fields: [sessionId, reversesEntryId], references: [sessionId, id], onDelete: Restrict)
  corrections ScoreEntry[]   @relation("ScoreCorrection")

  @@unique([sessionId, id])
  @@unique([sessionId, awardKey])
  @@index([sessionId, recipientPlayerId])
  @@index([sessionId, recipientTeamId])
  @@index([sessionId, transferGroupId])
  @@map("score_entries")
}

model AuditEvent {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId  String   @db.Uuid
  commandId  String?  @db.Uuid
  revision   Int
  eventIndex Int      @default(0)
  kind       String   @db.VarChar(100)
  details    Json     @db.JsonB
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  session GameSession  @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  command GameCommand? @relation(fields: [sessionId, commandId], references: [sessionId, id], onDelete: Restrict)

  @@unique([sessionId, revision, eventIndex])
  @@map("audit_events")
}

model OutboxEvent {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId   String        @db.Uuid
  revision    Int
  eventIndex  Int           @default(0)
  audience    EventAudience
  audienceKey String        @db.VarChar(160)
  type        String        @db.VarChar(100)
  payload     Json          @db.JsonB
  attempts    Int           @default(0)
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  availableAt DateTime      @default(now()) @db.Timestamptz(3)
  publishedAt DateTime?     @db.Timestamptz(3)

  session GameSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@unique([sessionId, revision, eventIndex, audienceKey])
  @@index([publishedAt, availableAt])
  @@map("outbox_events")
}

enum FeedbackKind {
  BUG
  FEATURE
  MINIGAME
}

enum FeedbackStatus {
  NEW
  PLANNED
  IN_PROGRESS
  DONE
  DECLINED
}

// Reports from people trying the test version. The id is chosen by the sending
// browser, so a retried send is stored once. Context (page, pointed-at
// elements and where they are in the web code) is validated by the contract.
model FeedbackItem {
  id           String         @id @db.Uuid
  kind         FeedbackKind
  status       FeedbackStatus @default(NEW)
  title        String         @db.VarChar(140)
  details      String         @db.Text
  reporterName String?        @db.VarChar(60)
  context      Json           @db.JsonB
  ownerNote    String?        @db.Text
  createdAt    DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime       @default(now()) @updatedAt @db.Timestamptz(3)

  attachment FeedbackAttachment?

  @@index([status, createdAt])
  @@map("feedback_items")
}

model FeedbackAttachment {
  feedbackId  String       @id @db.Uuid
  contentType String       @db.VarChar(24)
  data        Bytes
  feedback    FeedbackItem @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  @@map("feedback_attachments")
}

// People: accounts the owner makes so a phone always joins as the same person
// (name, look, chips across games). A personal link signs a phone in once; each
// phone then holds its own device key. Players without one join as guests.
model Person {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String    @db.VarChar(40)
  // Lower-case name: two people cannot share a name.
  nameKey   String    @unique @db.VarChar(40)
  // SHA-256 of the current personal key (or an older personal link); a new key replaces it.
  linkHash  String    @unique @db.Char(64)
  // The current key, encrypted with a key derived from ROOM_TOKEN_SECRET, so the
  // owner can look it up again. Null for people made before keys could be looked up.
  keySealed String?   @db.VarChar(200)
  // May edit games (never host rooms or use the admin menu).
  canEdit   Boolean   @default(false)
  look      Json?     @db.JsonB
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  removedAt DateTime? @db.Timestamptz(3)

  devices PersonDevice[]
  players SessionPlayer[]
  chips   ChipEntry[]
  rounds  SideRound[]
  items   CollectedItem[]
  arcadeMembers ArcadeMember[]
  arcadeResults ArcadeResult[]
  groups        PersonGroupMember[]
  media         GameMedia[]

  @@map("people")
}

enum GameMediaKind {
  IMAGE
  VIDEO
  AUDIO
  FONT
}

// The media library: pictures, videos, songs and fonts the owner and editors upload for their games
// (a scene shows one). The bytes live in the media folder under game-media/<id>, apart from the
// rooms' uploads, so the room clean-up never touches them. Removing one keeps the row (removedAt).
model GameMedia {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind        GameMediaKind
  contentType String        @db.VarChar(64)
  byteSize    Int
  sha256      String        @db.Char(64)
  // The uploaded file's name, to recognise it in the library.
  name        String        @db.VarChar(120)
  // Who made it and under which licence, shown when it plays ("Hotrock" Kevin MacLeod (incompetech.com), CC BY 4.0). Null: nothing to credit.
  credit      String?       @db.VarChar(300)
  // Who uploaded it: an editor, or null for the owner.
  personId    String?       @db.Uuid
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  removedAt   DateTime?     @db.Timestamptz(3)

  person Person? @relation(fields: [personId], references: [id], onDelete: Restrict)

  @@index([removedAt, createdAt])
  @@map("game_media")
}

// A named group of people (Admin → People → Groups), to add many people to a room at once.
// Not history: deleting a group removes only the group and its member list, never the people.
model PersonGroup {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @db.VarChar(40)
  // Lower-case name: two groups cannot share a name.
  nameKey   String   @unique @db.VarChar(40)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  members PersonGroupMember[]

  @@map("person_groups")
}

model PersonGroupMember {
  groupId  String   @db.Uuid
  personId String   @db.Uuid
  addedAt  DateTime @default(now()) @db.Timestamptz(3)

  group  PersonGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  person Person      @relation(fields: [personId], references: [id], onDelete: Restrict)

  @@id([groupId, personId])
  @@index([personId])
  @@map("person_group_members")
}

model PersonDevice {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  personId   String    @db.Uuid
  tokenHash  String    @unique @db.Char(64)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  lastSeenAt DateTime  @default(now()) @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)

  person Person @relation(fields: [personId], references: [id], onDelete: Restrict)

  @@index([personId])
  @@map("person_devices")
}

enum ChipReason {
  START
  REFILL
  BET
  PAYOUT
  // Chips won by playing: points, place and wins of a finished game, a won arcade round (side-games/earnings.ts).
  EARNED
}

// Play chips (never money) as an append-only ledger. The wallet is the
// person's when personId is set (it carries over between games), otherwise the
// guest seat's (this room only). playerId and sessionId record where it happened.
model ChipEntry {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId String     @db.Uuid
  playerId  String     @db.Uuid
  personId  String?    @db.Uuid
  roundId   String?    @db.Uuid
  game      String?    @db.VarChar(20)
  reason    ChipReason
  amount    Int
  createdAt DateTime   @default(now()) @db.Timestamptz(3)

  player SessionPlayer @relation(fields: [sessionId, playerId], references: [sessionId, id], onDelete: Restrict)
  person Person?       @relation(fields: [personId], references: [id], onDelete: Restrict)
  round  SideRound?    @relation(fields: [roundId], references: [id], onDelete: Restrict)

  @@index([personId])
  @@index([playerId])
  @@index([sessionId])
  @@map("chip_entries")
}

// One go at a side game: a spin, a pack, or a blackjack hand (which can take
// several moves). The id is chosen by the phone, so a retried request is one go.
// `state` is server-only (the dealer's hidden card); `step` orders the moves.
model SideRound {
  id        String   @id @db.Uuid
  sessionId String   @db.Uuid
  playerId  String   @db.Uuid
  personId  String?  @db.Uuid
  game      String   @db.VarChar(20)
  finished  Boolean  @default(false)
  step      Int      @default(0)
  bet       Int
  payout    Int      @default(0)
  state     Json     @db.JsonB
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  player SessionPlayer   @relation(fields: [sessionId, playerId], references: [sessionId, id], onDelete: Restrict)
  person Person?         @relation(fields: [personId], references: [id], onDelete: Restrict)
  chips  ChipEntry[]
  items  CollectedItem[]

  @@index([playerId, game, finished])
  @@map("side_rounds")
}

// Items from opened packs, owned like chips (person, else guest seat).
model CollectedItem {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId String   @db.Uuid
  playerId  String   @db.Uuid
  personId  String?  @db.Uuid
  roundId   String   @db.Uuid
  itemKey   String   @db.VarChar(40)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  player SessionPlayer @relation(fields: [sessionId, playerId], references: [sessionId, id], onDelete: Restrict)
  person Person?       @relation(fields: [personId], references: [id], onDelete: Restrict)
  round  SideRound     @relation(fields: [roundId], references: [id], onDelete: Restrict)

  @@index([personId])
  @@index([playerId])
  @@map("collected_items")
}

// Prefabs: scenes (with the connections between them and their card positions)
// saved from the editor to insert into any game. Content is checked for shape and
// size here; the game it is inserted into is validated on save like any draft.
model ScenePrefab {
  id         String   @id @db.Uuid
  creatorId  String   @db.Uuid
  name       String   @db.VarChar(80)
  sceneCount Int
  content    Json     @db.JsonB
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  creator Creator @relation(fields: [creatorId], references: [id], onDelete: Restrict)

  @@index([creatorId, createdAt])
  @@map("scene_prefabs")
}

// Saved styles: looks made in Look & feel to reuse in other games, shared by the owner and editors
// like prefabs. Games copy the values when they use one, so a change here never alters a game.
model ThemeStyle {
  id        String   @id @db.Uuid
  creatorId String   @db.Uuid
  name      String   @db.VarChar(60)
  theme     Json     @db.JsonB
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  creator Creator @relation(fields: [creatorId], references: [id], onDelete: Restrict)

  @@index([creatorId, createdAt])
  @@map("theme_styles")
}

// A challenge between two players of a room (rock paper scissors, tic-tac-toe,
// chess…), optionally for a stake in chips. Only kept while the room is on:
// the clean-up returns any stake still held and deletes the row (and with it
// the game and its replay) once the room has ended or gone quiet.
model SideChallenge {
  id           String   @id @db.Uuid
  sessionId    String   @db.Uuid
  challengerId String   @db.Uuid
  opponentId   String   @db.Uuid
  game         String   @db.VarChar(20)
  // Chips each player puts in; the winner takes both, a draw returns them.
  stake        Int
  // INVITED, PLAYING, FINISHED, DECLINED or CANCELLED.
  status       String   @db.VarChar(12)
  // The match: the game's own state (see src/head-to-head/match.ts).
  state        Json     @db.JsonB
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  challenger SessionPlayer @relation("ChallengeChallenger", fields: [sessionId, challengerId], references: [sessionId, id], onDelete: Restrict)
  opponent   SessionPlayer @relation("ChallengeOpponent", fields: [sessionId, opponentId], references: [sessionId, id], onDelete: Restrict)

  @@index([sessionId, status])
  @@map("side_challenges")
}

// Arcade: lobbies any player opens to play minigames together, outside a game.
// The lobby and its members last across rounds; each round is an ordinary room
// (game session) with one minigame scene, hosted by the arcade's own creator,
// into which the lobby's members are seated. The leader (a member) runs the round.
// A lobby nobody has been seen in for 15 minutes is closed.
model ArcadeLobby {
  id           String    @id @db.Uuid
  title        String    @db.VarChar(60)
  // Locked: nobody new may join; members can still come back.
  locked       Boolean   @default(false)
  passwordHash String?   @db.VarChar(100)
  leaderId     String?   @db.Uuid
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  // The last time any member was seen; the lobby closes after 15 quiet minutes.
  lastActiveAt DateTime  @default(now()) @db.Timestamptz(3)
  closedAt     DateTime? @db.Timestamptz(3)

  members ArcadeMember[]
  rounds  ArcadeRound[]

  @@index([closedAt, lastActiveAt])
  @@map("arcade_lobbies")
}

model ArcadeMember {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lobbyId     String    @db.Uuid
  // SHA-256 of the member key in this browser's HttpOnly cookie.
  tokenHash   String    @unique @db.Char(64)
  displayName String    @db.VarChar(40)
  // The person (account) this member is; null for guests.
  personId    String?   @db.Uuid
  look        Json?     @db.JsonB
  joinedAt    DateTime  @default(now()) @db.Timestamptz(3)
  lastSeenAt  DateTime  @default(now()) @db.Timestamptz(3)
  leftAt      DateTime? @db.Timestamptz(3)

  lobby   ArcadeLobby    @relation(fields: [lobbyId], references: [id], onDelete: Restrict)
  person  Person?        @relation(fields: [personId], references: [id], onDelete: Restrict)
  seats   ArcadeSeat[]
  results ArcadeResult[]

  // A person is one member of a lobby: joining again continues it.
  @@unique([lobbyId, personId])
  @@index([lobbyId, joinedAt])
  @@map("arcade_members")
}

model ArcadeRound {
  id        String    @id @db.Uuid
  lobbyId   String    @db.Uuid
  sessionId String    @unique @db.Uuid
  number    Int
  game      String    @db.VarChar(20)
  // Null for everyone on their own; otherwise the number of teams.
  teams     Int?
  startedAt DateTime  @default(now()) @db.Timestamptz(3)
  // Set once the round's results are recorded (or it was abandoned).
  endedAt   DateTime? @db.Timestamptz(3)

  lobby   ArcadeLobby    @relation(fields: [lobbyId], references: [id], onDelete: Restrict)
  session GameSession    @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  seats   ArcadeSeat[]
  results ArcadeResult[]

  @@unique([lobbyId, number])
  @@index([lobbyId, endedAt])
  @@map("arcade_rounds")
}

// Which member plays in which seat of a round's room.
model ArcadeSeat {
  roundId  String @db.Uuid
  memberId String @db.Uuid
  playerId String @unique @db.Uuid

  round  ArcadeRound   @relation(fields: [roundId], references: [id], onDelete: Restrict)
  member ArcadeMember  @relation(fields: [memberId], references: [id], onDelete: Restrict)
  player SessionPlayer @relation(fields: [playerId], references: [id], onDelete: Restrict)

  @@id([roundId, memberId])
  @@map("arcade_seats")
}

// A member's result in one round: the lobby's running total and the all-time
// leaderboards (people only) are sums and bests over these rows.
model ArcadeResult {
  roundId     String   @db.Uuid
  memberId    String   @db.Uuid
  personId    String?  @db.Uuid
  game        String   @db.VarChar(20)
  // 1 for a win (own place, or the team's); null when unranked or no result.
  place       Int?
  pointsMilli BigInt
  // The measured result (ms, taps…), null for none or a false start.
  value       Int?
  // Lower is better; only for ranked results played alone (the leaderboards' "best").
  bestKey     Int?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  round  ArcadeRound  @relation(fields: [roundId], references: [id], onDelete: Restrict)
  member ArcadeMember @relation(fields: [memberId], references: [id], onDelete: Restrict)
  person Person?      @relation(fields: [personId], references: [id], onDelete: Restrict)

  @@id([roundId, memberId])
  @@index([personId, game])
  @@index([game, bestKey])
  @@map("arcade_results")
}

// Pack sets the owner makes and changes (Admin → Chips & packs; side-games/pack-sets.ts): a name, a price, the
// chance of each rarity (percent, adding up to 100) and of a god pack (1 in godPackOdds, 0 = never), and items.
// Removing a set or an item never takes it from whoever has one: it is archived (set) or retired (item).
model PackSet {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String    @db.VarChar(60)
  price       Int
  /// Players see the set (false: hidden from players).
  active      Boolean   @default(true)
  /// On sale: salePercent off the price, for as long as the owner keeps it on.
  onSale      Boolean   @default(false)
  salePercent Int       @default(50)
  sortOrder   Int       @default(0)
  chances     Json      @db.JsonB
  godPackOdds Int       @default(0)
  archivedAt  DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @default(now()) @updatedAt @db.Timestamptz(3)

  items PackItem[]

  @@map("pack_sets")
}

// One item of a pack set. `key` is what collections store (collected_items.itemKey), so it never changes.
model PackItem {
  key       String    @id @db.VarChar(40)
  setId     String    @db.Uuid
  name      String    @db.VarChar(40)
  emoji     String    @default("") @db.VarChar(16)
  rarity    String    @db.VarChar(12)
  /// An uploaded picture (media folder pack-items/<id>.png) shown instead of the emoji; null: the emoji.
  imageId   String?   @db.Uuid
  flavor    String    @default("") @db.VarChar(120)
  sortOrder Int       @default(0)
  retiredAt DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  set PackSet @relation(fields: [setId], references: [id], onDelete: Restrict)

  @@index([setId])
  @@map("pack_items")
}

// Site-wide settings the owner changes, one JSON value per key, validated by the contracts
// (for now 'economy': start chips and what playing earns; side-games/economy.ts).
model SiteSetting {
  key       String   @id @db.VarChar(40)
  value     Json     @db.JsonB
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  @@map("site_settings")
}
