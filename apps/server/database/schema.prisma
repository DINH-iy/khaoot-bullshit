generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum SessionMode {
  LIVE
  REHEARSAL
}

enum SessionStatus {
  LOBBY
  RUNNING
  PAUSED
  RECOVERING
  FINISHED
}

enum StageStatus {
  ACTIVE
  CLOSED
  VOID
}

enum AssetKind {
  IMAGE
  GIF
  VIDEO
  // Strokes as validated JSON (see the drawing contract), never an image.
  DRAWING
}

// What a stored file is for: an answer in a round (or a part of a relay drawing), or a player's picture.
enum AssetPurpose {
  ANSWER
  AVATAR
}

enum ScoreKind {
  AWARD
  ADJUSTMENT
  REVERSAL
  TRANSFER
}

enum DecisionReason {
  VOTE
  HOST
  TIE_BREAK
  FALLBACK
}

enum EventAudience {
  HOST
  DISPLAY
  PLAYER
}

enum RoomRole {
  HOST
  DISPLAY
}

enum CredentialSource {
  OIDC
  LOCAL_REHEARSAL
}

// Authoring: mutable drafts and immutable published versions share one database.
model Creator {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  issuer    String   @db.VarChar(512)
  subject   String   @db.VarChar(255)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  games    Game[]
  versions GameVersion[]
  sessions GameSession[]

  @@unique([issuer, subject])
  @@map("creators")
}

model Game {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  creatorId  String    @db.Uuid
  title      String    @db.VarChar(160)
  archivedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @default(now()) @updatedAt @db.Timestamptz(3)

  creator  Creator       @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  draft    GameDraft?
  versions GameVersion[]

  @@index([creatorId, archivedAt])
  @@map("games")
}

model GameDraft {
  gameId           String   @id @db.Uuid
  revision         Int      @default(0)
  definitionFormat Int      @default(1)
  definition       Json     @db.JsonB
  updatedAt        DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  game Game @relation(fields: [gameId], references: [id], onDelete: Restrict)

  @@map("game_drafts")
}

model GameVersion {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  gameId           String   @db.Uuid
  number           Int
  definitionFormat Int      @default(1)
  definition       Json     @db.JsonB
  contentHash      String   @db.Char(64)
  createdById      String   @db.Uuid
  createdAt        DateTime @default(now()) @db.Timestamptz(3)

  game      Game          @relation(fields: [gameId], references: [id], onDelete: Restrict)
  createdBy Creator       @relation(fields: [createdById], references: [id], onDelete: Restrict)
  sessions  GameSession[]

  @@unique([gameId, number])
  @@map("game_versions")
}

// Runtime: each session uses one immutable version, never the current draft.
model GameSession {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  gameVersionId  String        @db.Uuid
  hostId         String        @db.Uuid
  mode           SessionMode   @default(LIVE)
  status         SessionStatus @default(LOBBY)
  roomCode       String?       @unique @db.VarChar(12)
  revision       Int           @default(0)
  currentNodeKey String?       @db.VarChar(128)
  state          Json          @default("{}") @db.JsonB
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @default(now()) @updatedAt @db.Timestamptz(3)
  endedAt        DateTime?     @db.Timestamptz(3)

  gameVersion GameVersion     @relation(fields: [gameVersionId], references: [id], onDelete: Restrict)
  host        Creator         @relation(fields: [hostId], references: [id], onDelete: Restrict)
  players     SessionPlayer[]
  teams       SessionTeam[]
  lineups     TeamLineup[]
  stages      StageRun[]
  commands    GameCommand[]
  auditEvents AuditEvent[]
  outbox      OutboxEvent[]
  roomCredentials RoomCredential[]

  @@index([hostId, status])
  @@index([gameVersionId])
  @@map("game_sessions")
}

model SessionPlayer {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId   String    @db.Uuid
  displayName String    @db.VarChar(40)
  joinedAt    DateTime  @default(now()) @db.Timestamptz(3)
  leftAt      DateTime? @db.Timestamptz(3)
  joinKeyHash String?   @unique @db.Char(64)
  // The person (account the owner made) this seat belongs to; null for guests.
  personId    String?   @db.Uuid
  // The player's own look: built-in character parts, validated by PlayerLookSchema. Null means the default made from the ID.
  look        Json?     @db.JsonB

  session     GameSession        @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  credentials PlayerCredential[]
  memberships TeamMember[]
  submissions Submission[]
  scores      ScoreEntry[]
  judgments   StageJudgment[]
  assets      Asset[]
  person      Person?            @relation(fields: [personId], references: [id], onDelete: Restrict)
  chips       ChipEntry[]
  sideRounds  SideRound[]
  items       CollectedItem[]

  @@unique([sessionId, id])
  // A person has at most one seat per room: joining again continues it.
  @@unique([sessionId, personId])
  @@map("session_players")
}

model RoomCredential {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId String @db.Uuid
  role      RoomRole
  source    CredentialSource @default(OIDC)
  tokenHash String @unique @db.Char(64)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)

  session GameSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@index([sessionId, role])
  @@map("room_credentials")
}

model PlayerCredential {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId String    @db.Uuid
  playerId  String    @db.Uuid
  tokenHash String    @unique @db.Char(64)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt DateTime  @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)

  player SessionPlayer @relation(fields: [sessionId, playerId], references: [sessionId, id], onDelete: Restrict)

  @@index([sessionId, playerId])
  @@map("player_credentials")
}

model SessionTeam {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId String   @db.Uuid
  name      String   @db.VarChar(60)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  session     GameSession  @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  memberships TeamMember[]
  submissions Submission[]
  scores      ScoreEntry[]

  @@unique([sessionId, id])
  @@unique([sessionId, name])
  @@map("session_teams")
}

model TeamLineup {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId String   @db.Uuid
  number    Int
  carryover Json     @default("{}") @db.JsonB
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  session GameSession  @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  members TeamMember[]
  stages  StageRun[]
  scores  ScoreEntry[]

  @@unique([sessionId, id])
  @@unique([sessionId, number])
  @@map("team_lineups")
}

model TeamMember {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId String  @db.Uuid
  lineupId  String  @db.Uuid
  teamId    String  @db.Uuid
  playerId  String  @db.Uuid
  isCaptain Boolean @default(false)

  lineup TeamLineup    @relation(fields: [sessionId, lineupId], references: [sessionId, id], onDelete: Restrict)
  team   SessionTeam   @relation(fields: [sessionId, teamId], references: [sessionId, id], onDelete: Restrict)
  player SessionPlayer @relation(fields: [sessionId, playerId], references: [sessionId, id], onDelete: Restrict)

  @@unique([lineupId, playerId])
  @@index([sessionId, teamId])
  @@map("team_members")
}

model StageRun {
  id                String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId         String      @db.Uuid
  number            Int
  nodeKey           String      @db.VarChar(128)
  stageKey          String      @db.VarChar(128)
  status            StageStatus @default(ACTIVE)
  lineupId          String?     @db.Uuid
  eligibility       Json        @default("{}") @db.JsonB
  presentation      Json        @default("{}") @db.JsonB
  openedAt          DateTime    @default(now()) @db.Timestamptz(3)
  deadlineAt        DateTime?   @db.Timestamptz(3)
  pausedRemainingMs Int?
  closedAt          DateTime?   @db.Timestamptz(3)
  // Results (answer, awards, scores) of a closed stage become public only once revealed.
  revealedAt        DateTime?   @db.Timestamptz(3)

  session     GameSession     @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  lineup      TeamLineup?     @relation(fields: [sessionId, lineupId], references: [sessionId, id], onDelete: Restrict)
  submissions Submission[]
  decision    RouteDecision?
  scores      ScoreEntry[]
  judgments   StageJudgment[]
  assets      Asset[]

  @@unique([sessionId, id])
  @@unique([sessionId, number])
  @@map("stage_runs")
}

model Submission {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId  String   @db.Uuid
  stageRunId String   @db.Uuid
  actorKey   String   @db.VarChar(160)
  slotKey    String   @default("answer") @db.VarChar(128)
  playerId   String?  @db.Uuid
  teamId     String?  @db.Uuid
  revision   Int      @default(0)
  value      Json     @db.JsonB
  receivedAt DateTime @default(now()) @db.Timestamptz(3)

  stage  StageRun       @relation(fields: [sessionId, stageRunId], references: [sessionId, id], onDelete: Restrict)
  player SessionPlayer? @relation(fields: [sessionId, playerId], references: [sessionId, id], onDelete: Restrict)
  team   SessionTeam?   @relation(fields: [sessionId, teamId], references: [sessionId, id], onDelete: Restrict)
  asset  Asset?

  @@unique([stageRunId, actorKey, slotKey])
  @@index([sessionId, stageRunId])
  @@map("submissions")
}

// An uploaded picture, GIF or video. The bytes live on disk under the media
// directory; this row is the authority on who uploaded it, for which stage,
// what it was verified to be, and which saved answer uses it.
model Asset {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId    String    @db.Uuid
  // Null for a player's picture, which belongs to no round.
  stageRunId   String?   @db.Uuid
  playerId     String    @db.Uuid
  kind         AssetKind
  purpose      AssetPurpose @default(ANSWER)
  contentType  String    @db.VarChar(64)
  byteSize     Int
  sha256       String    @db.Char(64)
  submissionId String?   @unique @db.Uuid
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  // Set when the file was deleted by the clean-up; the row stays for history and audit.
  removedAt    DateTime? @db.Timestamptz(3)

  stage      StageRun?     @relation(fields: [sessionId, stageRunId], references: [sessionId, id], onDelete: Restrict)
  player     SessionPlayer @relation(fields: [sessionId, playerId], references: [sessionId, id], onDelete: Restrict)
  submission Submission?   @relation(fields: [submissionId], references: [id], onDelete: Restrict)

  @@unique([sessionId, id])
  @@index([stageRunId, playerId])
  @@index([sessionId, removedAt])
  @@map("assets")
}

model RouteDecision {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId          String         @db.Uuid
  stageRunId         String         @unique @db.Uuid
  commandId          String         @db.Uuid
  selectedEdgeKey    String         @db.VarChar(128)
  destinationNodeKey String         @db.VarChar(128)
  reason             DecisionReason
  voteSnapshot       Json           @db.JsonB
  createdAt          DateTime       @default(now()) @db.Timestamptz(3)

  stage   StageRun    @relation(fields: [sessionId, stageRunId], references: [sessionId, id], onDelete: Restrict)
  command GameCommand @relation(fields: [sessionId, commandId], references: [sessionId, id], onDelete: Restrict)

  @@unique([sessionId, stageRunId])
  @@map("route_decisions")
}

// A row represents a committed outcome, written with its related state/audit/outbox.
model GameCommand {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId   String   @db.Uuid
  commandKey  String   @db.Uuid
  actorKey    String   @db.VarChar(160)
  type        String   @db.VarChar(80)
  requestHash String   @db.Char(64)
  result      Json     @db.JsonB
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  session   GameSession     @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  scores    ScoreEntry[]
  decisions RouteDecision[]
  audit     AuditEvent[]
  judgments StageJudgment[]

  @@unique([sessionId, id])
  @@unique([sessionId, actorKey, commandKey])
  @@map("game_commands")
}

// A zero-point decision is still a durable judgment. Corrections are a later
// append-only operation, not an update of this historical decision.
model StageJudgment {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId   String   @db.Uuid
  stageRunId  String   @db.Uuid
  playerId    String   @db.Uuid
  commandId   String   @db.Uuid
  amountMilli BigInt
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  stage   StageRun      @relation(fields: [sessionId, stageRunId], references: [sessionId, id], onDelete: Restrict)
  player  SessionPlayer @relation(fields: [sessionId, playerId], references: [sessionId, id], onDelete: Restrict)
  command GameCommand   @relation(fields: [sessionId, commandId], references: [sessionId, id], onDelete: Restrict)

  @@unique([stageRunId, playerId])
  @@index([sessionId, commandId])
  @@map("stage_judgments")
}

// Signed fixed-point integers: 1,000 milli-points = 1 point. Never JS floats.
model ScoreEntry {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId         String    @db.Uuid
  commandId         String    @db.Uuid
  awardKey          String    @db.VarChar(200)
  stageRunId        String?   @db.Uuid
  lineupId          String?   @db.Uuid
  recipientPlayerId String?   @db.Uuid
  recipientTeamId   String?   @db.Uuid
  amountMilli       BigInt
  kind              ScoreKind
  reason            String    @db.VarChar(240)
  reversesEntryId   String?   @db.Uuid
  transferGroupId   String?   @db.Uuid
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)

  command     GameCommand    @relation(fields: [sessionId, commandId], references: [sessionId, id], onDelete: Restrict)
  stage       StageRun?      @relation(fields: [sessionId, stageRunId], references: [sessionId, id], onDelete: Restrict)
  lineup      TeamLineup?    @relation(fields: [sessionId, lineupId], references: [sessionId, id], onDelete: Restrict)
  player      SessionPlayer? @relation(fields: [sessionId, recipientPlayerId], references: [sessionId, id], onDelete: Restrict)
  team        SessionTeam?   @relation(fields: [sessionId, recipientTeamId], references: [sessionId, id], onDelete: Restrict)
  reverses    ScoreEntry?    @relation("ScoreCorrection", fields: [sessionId, reversesEntryId], references: [sessionId, id], onDelete: Restrict)
  corrections ScoreEntry[]   @relation("ScoreCorrection")

  @@unique([sessionId, id])
  @@unique([sessionId, awardKey])
  @@index([sessionId, recipientPlayerId])
  @@index([sessionId, recipientTeamId])
  @@index([sessionId, transferGroupId])
  @@map("score_entries")
}

model AuditEvent {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId  String   @db.Uuid
  commandId  String?  @db.Uuid
  revision   Int
  eventIndex Int      @default(0)
  kind       String   @db.VarChar(100)
  details    Json     @db.JsonB
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  session GameSession  @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  command GameCommand? @relation(fields: [sessionId, commandId], references: [sessionId, id], onDelete: Restrict)

  @@unique([sessionId, revision, eventIndex])
  @@map("audit_events")
}

model OutboxEvent {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId   String        @db.Uuid
  revision    Int
  eventIndex  Int           @default(0)
  audience    EventAudience
  audienceKey String        @db.VarChar(160)
  type        String        @db.VarChar(100)
  payload     Json          @db.JsonB
  attempts    Int           @default(0)
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  availableAt DateTime      @default(now()) @db.Timestamptz(3)
  publishedAt DateTime?     @db.Timestamptz(3)

  session GameSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@unique([sessionId, revision, eventIndex, audienceKey])
  @@index([publishedAt, availableAt])
  @@map("outbox_events")
}

enum FeedbackKind {
  BUG
  FEATURE
  MINIGAME
}

enum FeedbackStatus {
  NEW
  PLANNED
  IN_PROGRESS
  DONE
  DECLINED
}

// Reports from people trying the test version. The id is chosen by the sending
// browser, so a retried send is stored once. Context (page, pointed-at
// elements and where they are in the web code) is validated by the contract.
model FeedbackItem {
  id           String         @id @db.Uuid
  kind         FeedbackKind
  status       FeedbackStatus @default(NEW)
  title        String         @db.VarChar(140)
  details      String         @db.Text
  reporterName String?        @db.VarChar(60)
  context      Json           @db.JsonB
  ownerNote    String?        @db.Text
  createdAt    DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime       @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([status, createdAt])
  @@map("feedback_items")
}

// People: accounts the owner makes so a phone always joins as the same person
// (name, look, chips across games). A personal link signs a phone in once; each
// phone then holds its own device key. Players without one join as guests.
model Person {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String    @db.VarChar(40)
  // Lower-case name: two people cannot share a name.
  nameKey   String    @unique @db.VarChar(40)
  // SHA-256 of the current personal link; a new link replaces it.
  linkHash  String    @unique @db.Char(64)
  look      Json?     @db.JsonB
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  removedAt DateTime? @db.Timestamptz(3)

  devices PersonDevice[]
  players SessionPlayer[]
  chips   ChipEntry[]
  rounds  SideRound[]
  items   CollectedItem[]

  @@map("people")
}

model PersonDevice {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  personId   String    @db.Uuid
  tokenHash  String    @unique @db.Char(64)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  lastSeenAt DateTime  @default(now()) @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)

  person Person @relation(fields: [personId], references: [id], onDelete: Restrict)

  @@index([personId])
  @@map("person_devices")
}

enum ChipReason {
  START
  REFILL
  BET
  PAYOUT
}

// Play chips (never money) as an append-only ledger. The wallet is the
// person's when personId is set (it carries over between games), otherwise the
// guest seat's (this room only). playerId and sessionId record where it happened.
model ChipEntry {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId String     @db.Uuid
  playerId  String     @db.Uuid
  personId  String?    @db.Uuid
  roundId   String?    @db.Uuid
  game      String?    @db.VarChar(20)
  reason    ChipReason
  amount    Int
  createdAt DateTime   @default(now()) @db.Timestamptz(3)

  player SessionPlayer @relation(fields: [sessionId, playerId], references: [sessionId, id], onDelete: Restrict)
  person Person?       @relation(fields: [personId], references: [id], onDelete: Restrict)
  round  SideRound?    @relation(fields: [roundId], references: [id], onDelete: Restrict)

  @@index([personId])
  @@index([playerId])
  @@index([sessionId])
  @@map("chip_entries")
}

// One go at a side game: a spin, a pack, or a blackjack hand (which can take
// several moves). The id is chosen by the phone, so a retried request is one go.
// `state` is server-only (the dealer's hidden card); `step` orders the moves.
model SideRound {
  id        String   @id @db.Uuid
  sessionId String   @db.Uuid
  playerId  String   @db.Uuid
  personId  String?  @db.Uuid
  game      String   @db.VarChar(20)
  finished  Boolean  @default(false)
  step      Int      @default(0)
  bet       Int
  payout    Int      @default(0)
  state     Json     @db.JsonB
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  player SessionPlayer   @relation(fields: [sessionId, playerId], references: [sessionId, id], onDelete: Restrict)
  person Person?         @relation(fields: [personId], references: [id], onDelete: Restrict)
  chips  ChipEntry[]
  items  CollectedItem[]

  @@index([playerId, game, finished])
  @@map("side_rounds")
}

// Items from opened packs, owned like chips (person, else guest seat).
model CollectedItem {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId String   @db.Uuid
  playerId  String   @db.Uuid
  personId  String?  @db.Uuid
  roundId   String   @db.Uuid
  itemKey   String   @db.VarChar(40)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  player SessionPlayer @relation(fields: [sessionId, playerId], references: [sessionId, id], onDelete: Restrict)
  person Person?       @relation(fields: [personId], references: [id], onDelete: Restrict)
  round  SideRound     @relation(fields: [roundId], references: [id], onDelete: Restrict)

  @@index([personId])
  @@index([playerId])
  @@map("collected_items")
}
