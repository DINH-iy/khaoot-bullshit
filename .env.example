# Copy to .env. Never commit real credentials.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=info
APP_VERSION=local
PUBLIC_ORIGIN=http://127.0.0.1:5173
# Generated by npm run network:prepare; never share this secret.
# ROOM_TOKEN_SECRET=REPLACE_WITH_64_HEX_CHARACTERS
SERVE_WEB=false
# All three values are required together. Choose an OIDC provider later.
# Configure an API access token audience, not a browser ID-token audience.
# AUTH_ISSUER=https://issuer.example/
# AUTH_AUDIENCE=party-game-api
# AUTH_JWKS_URL=https://issuer.example/.well-known/jwks.json
# Optional OTLP/HTTP traces endpoint. No exporter runs when omitted.
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces

# Local PostgreSQL only; npm run db:env generates these ignored credentials.
POSTGRES_PASSWORD=REPLACE_DEV_PASSWORD
POSTGRES_TEST_PASSWORD=REPLACE_TEST_PASSWORD
DATABASE_URL=postgresql://party_dev:REPLACE_DEV_PASSWORD@127.0.0.1:55432/party_dev
TEST_DATABASE_URL=postgresql://party_test:REPLACE_TEST_PASSWORD@127.0.0.1:55433/party_test
DATABASE_POOL_MAX=5
